# Select demo, development, preview, or production explicitly.
EXPO_PUBLIC_KIN_ENVIRONMENT=demo

# Public web origin or deployment base used for one-time invitation links.
# Preview and production require HTTPS. Local development may use loopback HTTP.
EXPO_PUBLIC_KIN_PUBLIC_URL=

# Development, preview, and production require both public Supabase values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Connected Kin+ billing. Production requires the key for its target platform.
# Keep real public SDK keys in an untracked .env file or the EAS environment.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
