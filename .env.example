# Select demo, development, preview, or production explicitly.
EXPO_PUBLIC_KIN_ENVIRONMENT=demo

# Public web origin or deployment base used for one-time invitation links.
# Preview and production require HTTPS. Local development may use loopback HTTP.
EXPO_PUBLIC_KIN_PUBLIC_URL=

# Public address shown in safety reports and Profile support. Required for preview/production.
EXPO_PUBLIC_KIN_SUPPORT_EMAIL=

# Development, preview, and production require both public Supabase values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Connected Kin+ billing. Production requires the key for its target platform.
# Keep real public SDK keys in an untracked .env file or the EAS environment.
# Development/preview may use a RevenueCat Test Store key beginning test_.
# Production requires appl_ for iOS, goog_ for Android, and rcb_ for web.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=

# REVENUECAT_SECRET_API_KEY, REVENUECAT_WEBHOOK_AUTHORIZATION, and
# REVENUECAT_WEBHOOK_SIGNING_SECRET are intentionally absent. Set them only as
# Supabase Edge Function secrets; never add EXPO_PUBLIC_ variants.
