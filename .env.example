# Select demo, development, preview, or production explicitly.
EXPO_PUBLIC_KIN_ENVIRONMENT=demo

# Development, preview, and production require both public Supabase values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional native Kin+ billing. Keep real keys in an untracked .env file.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
